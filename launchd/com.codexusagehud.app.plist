<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.codexusagehud.app</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>app="$1"; [ -e "$app" ] || /bin/sleep 10; if [ ! -e "$app" ]; then /bin/rm -f "$HOME/Library/LaunchAgents/$0.plist"; /bin/launchctl bootout "gui/$(/usr/bin/id -u)/$0" 2&gt;/dev/null; exit 0; fi; exec "$1"</string>
		<string>com.codexusagehud.app</string>
		<string>%%APP_EXECUTABLE%%</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.codexusagehud.app</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
		<key>Crashed</key>
		<true/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>%%SUPPORT_DIR%%/logs/hud.log</string>
	<key>StandardErrorPath</key>
	<string>%%SUPPORT_DIR%%/logs/hud.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>%%BIN_DIR%%:%%HOME%%/.local/bin:%%HOME%%/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>CODEX_USAGE_HUD_STATE_DIR</key>
		<string>%%STATE_DIR%%</string>
	</dict>
</dict>
</plist>
